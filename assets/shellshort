$bashFunctions = @'
redacted-claude() {
    local d="/tmp/claude-$(id -u)"
    mkdir -p -- "$d" || return 22
    [ ! -L "$d" ] && [ -d "$d" ] && [ -O "$d" ] || return 22
    chmod 700 "$d" || return 22
    nono run --profile redacted-claude --allow-cwd --allow-domain "$REDACTED_PROXY_HOST" -- claude "$@"
}
redacted-codex() {
    nono run --profile redacted-codex --allow-cwd --allow-domain "$REDACTED_PROXY_HOST" -- codex "$@"
}
redacted-opencode() {
    nono run --profile redacted-opencode --allow-cwd --allow-domain "$REDACTED_PROXY_HOST" -- opencode "$@"
}
'@

$payload = [Convert]::ToBase64String(
    [Text.Encoding]::UTF8.GetBytes($bashFunctions + "`n")
)

$argumentList = "-d Nono-1-0-0 -u nono -- /bin/bash -c `"printf %s $payload | base64 -d >> /home/nono/.bashrc`""

Start-ADTProcessAsUser `
    -FilePath "$env:SystemRoot\System32\wsl.exe" `
    -ArgumentList $argumentList `
    -CreateNoWindow
